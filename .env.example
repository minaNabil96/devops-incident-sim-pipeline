# Google Gemini API Configuration (OpenAI-compatible endpoint)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: extra Gemini keys, tried after GEMINI_API_KEY for EVERY model.
# Quota is per Google Cloud project per model, so keys from different
# projects multiply free capacity (keys from one project share one quota).
# Accepts a comma-separated list (Streamlit secrets may also use a TOML list).
# GEMINI_API_KEYS=second_key_here,third_key_here

# Optional: Override default model
# GEMINI_MODEL=gemini-3.8-flash

# Optional: ordered Gemini models tried before the fallback provider.
# Free-tier quota is granted per model per day, so a chain also multiplies
# free capacity. GEMINI_MODEL is always tried first.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Optional: Override API endpoint
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# --- AgentRouter (secondary provider, after every Gemini attempt) -----------
# OpenAI-compatible gateway exposing DeepSeek. Enabled only when the key is set.
# AGENTROUTER_API_KEY=your_agentrouter_api_key_here
# AGENTROUTER_MODEL=deepseek-v4-flash
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1/chat/completions

# --- Fallback provider (optional, last resort) -----------------------------
# When every Gemini model is exhausted or unavailable, the client retries
# against any OpenAI-compatible endpoint. Defaults to OrcaRouter; its free
# tier requires the workspace owner to link an established GitHub account
# (or add credits). Get a key (starts with sk-orca-) at https://www.orcarouter.ai
# Leave the key unset to disable the fallback entirely.
#
# Generic names take precedence, so the fallback can be repointed at another
# gateway (OpenRouter, Groq, ...) without code changes:
# FALLBACK_API_KEY=your_key_here
# FALLBACK_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# FALLBACK_MODEL=deepseek/deepseek-chat-v3.1:free
#
# ORCAROUTER_API_KEY=your_orcarouter_api_key_here
# ORCAROUTER_MODEL=deepseek/deepseek-v4-flash-free
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1/chat/completions
# ENABLE_LLM_FALLBACK=true